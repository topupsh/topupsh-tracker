# Copy to .env and `set -a; source .env; set +a` before `go run ./cmd/server`.
TOPUPSH_BASE_URL=http://localhost:5173
TOPUPSH_AUTH_JWT_SECRET=change-me-to-a-long-random-string
# Required. Encrypts the settings file (AES-256-GCM). Environment only: it is
# never read from YAML. At least 32 characters, e.g. `openssl rand -hex 32`.
# Losing it means the saved settings cannot be read; re-enter them on /setup.
TOPUPSH_MASTER_KEY=
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <TOPUPSH_BASE_URL>/auth/google/callback
TOPUPSH_AUTH_GOOGLE_CLIENT_ID=
TOPUPSH_AUTH_GOOGLE_CLIENT_SECRET=
# https://github.com/settings/developers
# Authorization callback URL: <TOPUPSH_BASE_URL>/auth/github/callback
TOPUPSH_AUTH_GITHUB_CLIENT_ID=
TOPUPSH_AUTH_GITHUB_CLIENT_SECRET=

# Unlocks /setup (generated and logged at startup when empty).
TOPUPSH_AUTH_ROOT_ACCESS_TOKEN=
# Where /setup saves settings; once saved they override these env values.
# TOPUPSH_SETTINGS_FILE=./_storage/settings.json

# Database: SQLite by default; set TOPUPSH_POSTGRES_ENABLED=true to use PostgreSQL.
# TOPUPSH_SQLITE_DSN=./_storage/topupsh-tracker.db
# TOPUPSH_POSTGRES_ENABLED=true
# TOPUPSH_POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/topupsh_tracker?sslmode=disable
